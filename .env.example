MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ayo_middleware
# Optional comma-separated DNS resolvers for mongodb+srv:// Atlas URIs.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Optional comma-separated host:port seed list to bypass SRV lookup while reusing MONGODB_URI credentials.
MONGODB_DIRECT_HOSTS=
SQLITE_DB_PATH=data/ayo_bridge.sqlite
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@ayo.local
ADMIN_PASSWORD=ChangeMe123!

AYO_BASE_URL=https://api.ayo.co.id/api/v2/third-party
AYO_VENUE_CODE=your-venue-code
AYO_BRANCH_NAME=your-branch-name
AYO_API_TOKEN=your-api-token
AYO_PRIVATE_KEY=your-private-key
AYO_WEBHOOK_SECRET=replace-with-webhook-secret
AYO_SYNC_MAX_DAYS=62
# Secret untuk endpoint cron auto-sync (/api/cron/sync). Vercel Cron mengirim header
# Authorization: Bearer <CRON_SECRET> secara otomatis bila env ini diset di project Vercel.
CRON_SECRET=replace-with-a-long-random-secret
