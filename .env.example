MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ayo_middleware
# Optional comma-separated DNS resolvers for mongodb+srv:// Atlas URIs.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Optional comma-separated host:port seed list to bypass SRV lookup while reusing MONGODB_URI credentials.
MONGODB_DIRECT_HOSTS=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@ayo.local
ADMIN_PASSWORD=ChangeMe123!
# Akun supervisor (di-seed otomatis saat login pertama; wajib format email, min. password 8 karakter)
SUPERVISOR_EMAIL=timunemas@ayo.local
SUPERVISOR_PASSWORD=replace-with-strong-password

AYO_BASE_URL=https://api.ayo.co.id/api/v2/third-party
AYO_VENUE_CODE=your-venue-code
AYO_BRANCH_NAME=your-branch-name
AYO_API_TOKEN=your-api-token
AYO_PRIVATE_KEY=your-private-key
AYO_WEBHOOK_SECRET=replace-with-webhook-secret
AYO_SYNC_MAX_DAYS=62
# Secret untuk endpoint cron auto-sync (/api/cron/sync). Vercel Cron mengirim header
# Authorization: Bearer <CRON_SECRET> secara otomatis bila env ini diset di project Vercel.
CRON_SECRET=replace-with-a-long-random-secret

# Olsera Open API (https://api-open.olsera.co.id) — read-only exploration script
OLSERA_APP_ID=
OLSERA_SECRET_KEY=
OLSERA_INTERNAL_BASE_URL=
OLSERA_INTERNAL_TOKEN=
OLSERA_INTERNAL_STORE_ID=
OLSERA_INTERNAL_STORE_SLUG=
OLSERA_FINANCIAL_BASELINE_PERIOD=2026-02
MONGODB_TEST_URI=
MONGODB_TEST_DB=financial_test

# Vercel Blob — penyimpanan lampiran Berita Acara Rekonsiliasi Omzet
# (app/api/reconciliation/court-revenue/[period]/attachment/route.ts).
# Dapatkan dari Vercel Dashboard > Storage > Blob > buat/pilih store >
# tab ".env.local" (atau `vercel env pull` bila project sudah ditautkan).
# JANGAN commit token asli — ini hanya placeholder.
BLOB_READ_WRITE_TOKEN=
